// "Glasshouse" (ultimate tier): hybrid rendering of a steel-and-glass conservatory with a
// pond, a chrome sculpture, trees and beds of grass. Rasterised G-buffer — the grass is
// generated by mesh shaders where available (identical vertex-shader fallback), drawn at a
// coarse shading rate where variable-rate shading exists — then one compute pass with ray
// queries traces sun shadows, ambient occlusion and reflections, and a composite pass
// tone-maps.
#include "common/bindings.slang"

struct Instance {
    float4 row0, row1, row2; // object-to-world 3x4 (the same matrix as the ray-tracing instance)
    float4 color;            // rgb albedo, w = material
    float4 info;             // x = mesh index
};

struct MeshInfo {
    uint firstIndex;
    uint indexCount;
    int baseVertex;
    uint pad;
};

struct FrameData {
    float4x4 viewProj;
    float4x4 invViewProj;
    float4 cameraPos; // xyz, w = time
    float4 sunDir;    // xyz towards the sun, w = intensity
    float4 sunColor;  // rgb, a = sun angular radius (soft shadows)
    float4 screen;    // width, height, 1/width, 1/height
    uint4 params;     // x = frame index, y = AO rays, z = grass blades per patch row, w = grass patches per bed row
    float4 grass;     // x = patch size (m), y = blade height, z = wind strength, w = bed count
    float4 beds[8];   // xyz bed centre, w = half size
};
ConstantBuffer<FrameData> frame : register(b0);

static const float kGround = 0.0, kSteel = 1.0, kChrome = 2.0, kWater = 3.0, kLeaves = 4.0, kBark = 5.0, kSoil = 6.0,
                   kGrass = 7.0, kStone = 8.0;

float3 transformPoint(float4 r0, float4 r1, float4 r2, float3 p) {
    return float3(dot(r0.xyz, p) + r0.w, dot(r1.xyz, p) + r1.w, dot(r2.xyz, p) + r2.w);
}

/// Normal transform by the cofactor matrix (inverse transpose up to scale) of the 3x3 part.
float3 transformNormal(float4 r0, float4 r1, float4 r2, float3 n) {
    float3 c0 = float3(r0.x, r1.x, r2.x), c1 = float3(r0.y, r1.y, r2.y), c2 = float3(r0.z, r1.z, r2.z);
    return normalize(cross(c1, c2) * n.x + cross(c2, c0) * n.y + cross(c0, c1) * n.z);
}

// --- G-buffer: instanced meshes --------------------------------------------------------------
struct VSIn {
    [[vk::location(0)]] float3 pos : ATTRIB0;
    [[vk::location(1)]] float3 normal : ATTRIB1;
    [[vk::location(2)]] float2 uv : ATTRIB2;
    [[vk::location(3)]] float4 row0 : ATTRIB3;
    [[vk::location(4)]] float4 row1 : ATTRIB4;
    [[vk::location(5)]] float4 row2 : ATTRIB5;
    [[vk::location(6)]] float4 color : ATTRIB6;
};

struct GOut {
    float4 pos : SV_Position;
    float3 world : TEXCOORD0;
    float3 normal : TEXCOORD1;
    nointerpolation float4 color : TEXCOORD2;
};

[shader("vertex")]
GOut vsGeometry(VSIn v) {
    GOut o;
    o.world = transformPoint(v.row0, v.row1, v.row2, v.pos);
    o.normal = transformNormal(v.row0, v.row1, v.row2, v.normal);
    o.pos = mul(frame.viewProj, float4(o.world, 1.0));
    o.color = v.color;
    return o;
}

struct GBuffer {
    float4 albedo : SV_Target0; // rgb albedo, a = metalness
    float4 normal : SV_Target1; // xyz normal, w = roughness (material id packed in the integer part / 16)
};

float hash2(float2 p) {
    uint2 q = uint2(int2(floor(p)) + 32768);
    return gtHashFloat(q.x * 73856093u ^ q.y * 19349663u);
}

float valueNoise(float2 p) {
    float2 i = floor(p), f = frac(p);
    float2 u = f * f * (3.0 - 2.0 * f);
    return lerp(lerp(hash2(i), hash2(i + float2(1, 0)), u.x), lerp(hash2(i + float2(0, 1)), hash2(i + float2(1, 1)), u.x), u.y);
}

/// Albedo, metalness and roughness of a material at a point.
void material(float m, float3 base, float3 w, float3 n, out float3 albedo, out float metal, out float rough) {
    albedo = base;
    metal = 0.0;
    rough = 0.6;
    if (m == kGround) {
        float2 t = floor(w.xz * 0.8);
        float checker = fmod(abs(t.x + t.y), 2.0);
        albedo = lerp(float3(0.70, 0.68, 0.64), float3(0.30, 0.32, 0.34), checker) * (0.9 + 0.1 * valueNoise(w.xz * 4.0));
        rough = 0.18;
    } else if (m == kSteel) {
        metal = 1.0;
        rough = 0.35;
    } else if (m == kChrome) {
        metal = 1.0;
        rough = 0.04;
    } else if (m == kWater) {
        albedo = float3(0.02, 0.05, 0.06);
        rough = 0.02;
    } else if (m == kLeaves || m == kGrass) {
        albedo *= 0.7 + 0.5 * valueNoise(w.xz * 3.0 + w.y);
        rough = 0.8;
    } else if (m == kSoil) {
        albedo *= 0.7 + 0.4 * valueNoise(w.xz * 6.0);
        rough = 0.95;
    } else if (m == kStone) {
        albedo *= 0.8 + 0.3 * valueNoise(w.xz * 2.0 + w.y * 3.0);
        rough = 0.7;
    }
}

GBuffer packGBuffer(float3 albedo, float metal, float rough, float3 n, float m) {
    GBuffer g;
    g.albedo = float4(albedo, metal);
    g.normal = float4(n, m * 2.0 + rough); // rough in [0, 1), material id in steps of 2
    return g;
}

[shader("fragment")]
GBuffer psGeometry(GOut i) {
    float3 n = normalize(i.normal);
    float3 albedo;
    float metal, rough;
    material(i.color.w, i.color.rgb, i.world, n, albedo, metal, rough);
    if (i.color.w == kWater) {
        float t = frame.cameraPos.w;
        n = normalize(float3(sin(i.world.x * 3.0 + t * 1.5) * 0.04 + sin(i.world.z * 4.7 - t) * 0.03, 1.0,
                             cos(i.world.z * 2.6 + t * 1.2) * 0.04));
    }
    return packGBuffer(albedo, metal, min(rough, 0.999), n, i.color.w);
}

// --- grass: identical blades from a mesh shader or an instanced vertex shader ------------------
struct GrassVertex {
    float4 pos : SV_Position;
    float3 world : TEXCOORD0;
    float3 normal : TEXCOORD1;
    float shade : TEXCOORD2;
};

static const uint kBladeVerts = 5;  // two quads with a shared row + tip
static const uint kBladeTris = 3;

/// Vertex k (0..4) of blade `blade` of patch `patch`.
GrassVertex grassVertex(uint patch, uint blade, uint k) {
    uint perRow = frame.params.z, patchesPerRow = frame.params.w;
    uint bed = patch / (patchesPerRow * patchesPerRow);
    uint local = patch % (patchesPerRow * patchesPerRow);
    float4 b = frame.beds[bed];
    float patchSize = frame.grass.x;
    float2 origin = b.xz - b.w + float2(float(local % patchesPerRow), float(local / patchesPerRow)) * patchSize;
    uint h = gtHash(patch * 7919u + blade * 104729u + 17u);
    float2 jitter = float2(gtHashFloat(h), gtHashFloat(h ^ 0x9E3779B9u));
    float2 cell = (float2(float(blade % perRow), float(blade / perRow)) + jitter) / float(perRow);
    float3 root = float3(origin.x + cell.x * patchSize, b.y, origin.y + cell.y * patchSize);
    float height = frame.grass.y * (0.6 + 0.8 * gtHashFloat(h * 3u));
    float angle = gtHashFloat(h * 5u) * 6.2831853;
    float2 facing = float2(cos(angle), sin(angle));
    float t = frame.cameraPos.w;
    float2 wind = float2(sin(t * 1.7 + root.x * 0.6), cos(t * 1.3 + root.z * 0.5)) * frame.grass.z;
    float row = float(k / 2u) / 2.0;     // 0, 0.5, 1
    float side = k == 4u ? 0.0 : (float(k & 1u) - 0.5) * (1.0 - row) * 0.06;
    float bend = row * row;
    float3 p = root + float3(facing.y * side, row * height, -facing.x * side) + float3(wind.x, 0.0, wind.y) * bend * height;
    GrassVertex o;
    o.world = p;
    o.normal = normalize(float3(facing.x, 0.4, facing.y));
    o.pos = mul(frame.viewProj, float4(p, 1.0));
    o.shade = 0.55 + 0.45 * row;
    return o;
}

uint3 grassTriangle(uint t) { return t == 0u ? uint3(0, 1, 2) : t == 1u ? uint3(2, 1, 3) : uint3(2, 3, 4); }

// Vertex fallback: instance = blade (patch-major), 9 vertices = 3 triangles.
[shader("vertex")]
GrassVertex vsGrass(uint vid: SV_VertexID, uint iid: SV_InstanceID) {
    uint perPatch = frame.params.z * frame.params.z;
    uint3 tri = grassTriangle(vid / 3u);
    uint corner = vid % 3u;
    uint k = corner == 0u ? tri.x : corner == 1u ? tri.y : tri.z;
    return grassVertex(iid / perPatch, iid % perPatch, k);
}

// Mesh shader: one workgroup per (patch, group of 32 blades).
[shader("mesh")]
[numthreads(32, 1, 1)]
[outputtopology("triangle")]
void msGrass(uint tid: SV_GroupThreadID, uint3 gid: SV_GroupID, OutputVertices<GrassVertex, 160> verts,
             OutputIndices<uint3, 96> tris) {
    uint perPatch = frame.params.z * frame.params.z;
    uint groupsPerPatch = (perPatch + 31u) / 32u;
    uint patch = gid.x / groupsPerPatch;
    uint first = (gid.x % groupsPerPatch) * 32u;
    uint blades = min(32u, perPatch - first);
    SetMeshOutputCounts(blades * kBladeVerts, blades * kBladeTris);
    if (tid < blades) {
        [unroll]
        for (uint k = 0; k < kBladeVerts; ++k) verts[tid * kBladeVerts + k] = grassVertex(patch, first + tid, k);
        [unroll]
        for (uint t = 0; t < kBladeTris; ++t) tris[tid * kBladeTris + t] = grassTriangle(t) + tid * kBladeVerts;
    }
}

[shader("fragment")]
GBuffer psGrass(GrassVertex i) {
    float3 albedo = float3(0.16, 0.34, 0.08) * i.shade * (0.8 + 0.4 * valueNoise(i.world.xz * 2.0));
    return packGBuffer(albedo, 0.0, 0.85, normalize(i.normal), kGrass);
}

// --- ray-traced lighting (compute, ray queries) -----------------------------------------------------
RaytracingAccelerationStructure scene : register(t0);
StructuredBuffer<Instance> instances : register(t1);
StructuredBuffer<MeshInfo> meshes : register(t2);
StructuredBuffer<float> vertices : register(t3); // scene::Vertex: 8 floats
StructuredBuffer<uint> indices : register(t4);
Texture2D<float4> gAlbedo : register(t5);
Texture2D<float4> gNormal : register(t6);
Texture2D<float> gDepth : register(t7);
RWTexture2D<float4> hdrOut : register(u0);
RWTexture2D<float4> visOut : register(u1); // csTrace: r = sun visibility, g = ambient occlusion
Texture2D<float4> gVis : register(t9);     // csLighting: the same, filtered here

float3 skyColor(float3 dir) {
    float h = saturate(dir.y);
    float3 sky = lerp(float3(0.78, 0.82, 0.88), float3(0.32, 0.50, 0.85), pow(h, 0.5));
    float sd = saturate(dot(dir, frame.sunDir.xyz));
    return sky + frame.sunColor.rgb * pow(sd, 900.0) * 40.0;
}

bool occluded(float3 origin, float3 dir, float tMax) {
    RayDesc r;
    r.Origin = origin;
    r.Direction = dir;
    r.TMin = 0.0;
    r.TMax = tMax;
    RayQuery<RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH | RAY_FLAG_FORCE_OPAQUE | RAY_FLAG_SKIP_CLOSEST_HIT_SHADER> q;
    q.TraceRayInline(scene, RAY_FLAG_NONE, 0xFF, r);
    q.Proceed();
    return q.CommittedStatus() != COMMITTED_NOTHING;
}

float3 vertexNormal(uint index) { return float3(vertices[index * 8u + 3u], vertices[index * 8u + 4u], vertices[index * 8u + 5u]); }

/// Shades the closest hit of a reflection ray: albedo with sun (shadowed) and sky ambient.
float3 shadeHit(RayQuery<RAY_FLAG_FORCE_OPAQUE> q, float3 dir) {
    Instance inst = instances[q.CommittedInstanceID()];
    MeshInfo m = meshes[uint(inst.info.x)];
    uint tri = m.firstIndex + q.CommittedPrimitiveIndex() * 3u;
    float2 bc = q.CommittedTriangleBarycentrics();
    float3 n0 = vertexNormal(uint(int(indices[tri]) + m.baseVertex));
    float3 n1 = vertexNormal(uint(int(indices[tri + 1u]) + m.baseVertex));
    float3 n2 = vertexNormal(uint(int(indices[tri + 2u]) + m.baseVertex));
    float3 nObj = n0 * (1.0 - bc.x - bc.y) + n1 * bc.x + n2 * bc.y;
    float3 n = transformNormal(inst.row0, inst.row1, inst.row2, nObj);
    if (dot(n, dir) > 0.0) n = -n;
    float3 p = q.WorldRayOrigin() + dir * q.CommittedRayT();
    float3 albedo;
    float metal, rough;
    material(inst.color.w, inst.color.rgb, p, n, albedo, metal, rough);
    float ndl = saturate(dot(n, frame.sunDir.xyz));
    float sun = ndl > 0.0 && !occluded(p + n * 0.02, frame.sunDir.xyz, 200.0) ? ndl : 0.0;
    float3 ambient = lerp(float3(0.10, 0.10, 0.09), float3(0.28, 0.33, 0.42), n.y * 0.5 + 0.5);
    float3 diffuse = albedo * (1.0 - metal);
    return diffuse * (frame.sunColor.rgb * frame.sunDir.w * sun + ambient) + albedo * metal * ambient;
}

float3 reconstruct(int2 px, float depth) {
    float2 ndc = ((float2(px) + 0.5) * frame.screen.zw) * float2(2.0, -2.0) + float2(-1.0, 1.0);
    float4 p = mul(frame.invViewProj, float4(ndc, depth, 1.0));
    return p.xyz / p.w;
}

float3 cosineDir(float3 n, float u1, float u2) {
    float r = sqrt(u1), phi = 6.2831853 * u2;
    float3 t = normalize(abs(n.y) < 0.99 ? cross(n, float3(0, 1, 0)) : cross(n, float3(1, 0, 0)));
    float3 b = cross(n, t);
    return normalize(t * (r * cos(phi)) + b * (r * sin(phi)) + n * sqrt(max(0.0, 1.0 - u1)));
}

uint pixelSeed(uint2 px) { return gtHash(px.x * 1973u + px.y * 9277u + frame.params.x * 26699u); }

// Pass 1: one soft-shadow ray towards a point on the sun's disc and a few short AO rays per pixel.
[shader("compute")]
[numthreads(8, 8, 1)]
void csTrace(uint3 tid: SV_DispatchThreadID) {
    if (tid.x >= uint(frame.screen.x) || tid.y >= uint(frame.screen.y)) return;
    int2 px = int2(tid.xy);
    float depth = gDepth.Load(int3(px, 0));
    if (depth >= 1.0) {
        visOut[tid.xy] = float4(1, 1, 0, 0);
        return;
    }
    float3 p = reconstruct(px, depth);
    float3 n = normalize(gNormal.Load(int3(px, 0)).xyz);
    uint seed = pixelSeed(tid.xy);
    float u1 = gtHashFloat(seed), u2 = gtHashFloat(seed ^ 0x68E31DA4u);
    float3 l = frame.sunDir.xyz;
    float3 lt = normalize(cross(l, float3(0, 1, 0))), lb = cross(l, lt);
    float rr = frame.sunColor.a * sqrt(u1), ph = 6.2831853 * u2;
    float3 ls = normalize(l + lt * (rr * cos(ph)) + lb * (rr * sin(ph)));
    float3 origin = p + n * 0.02;
    float shadow = dot(n, l) > 0.0 && !occluded(origin, ls, 200.0) ? 1.0 : 0.0;
    float ao = 0.0;
    uint aoRays = frame.params.y;
    [loop]
    for (uint k = 0; k < aoRays; ++k) {
        seed = gtHash(seed + k);
        ao += occluded(origin, cosineDir(n, gtHashFloat(seed), gtHashFloat(seed ^ 0xB5297A4Du)), 1.5) ? 0.0 : 1.0;
    }
    visOut[tid.xy] = float4(shadow, ao / float(max(aoRays, 1u)), 0, 0);
}

/// 5x5 cross-bilateral filter of the traced visibility: taps off the pixel's plane or with a
/// different normal get no weight, so penumbrae soften without leaking across edges.
float2 filteredVisibility(int2 px, float3 p, float3 n) {
    float dist = length(frame.cameraPos.xyz - p);
    int2 maxPx = int2(frame.screen.xy) - 1;
    float2 sum = float2(0, 0);
    float wsum = 0.0;
    [loop]
    for (int y = -2; y <= 2; ++y) {
        [loop]
        for (int x = -2; x <= 2; ++x) {
            int2 q = clamp(px + int2(x, y), int2(0, 0), maxPx);
            float dq = gDepth.Load(int3(q, 0));
            float3 nq = normalize(gNormal.Load(int3(q, 0)).xyz);
            float plane = abs(dot(n, reconstruct(q, dq) - p)) / (0.004 * dist + 0.01);
            float w = exp(-plane - 0.18 * float(x * x + y * y)) * pow(saturate(dot(n, nq)), 16.0) * step(dq, 0.99999994);
            sum += gVis.Load(int3(q, 0)).rg * w;
            wsum += w;
        }
    }
    return wsum > 1e-4 ? sum / wsum : gVis.Load(int3(px, 0)).rg;
}

// Pass 2: shading with the filtered visibility and one roughness-jittered reflection ray.
[shader("compute")]
[numthreads(8, 8, 1)]
void csLighting(uint3 tid: SV_DispatchThreadID) {
    if (tid.x >= uint(frame.screen.x) || tid.y >= uint(frame.screen.y)) return;
    int2 px = int2(tid.xy);
    float depth = gDepth.Load(int3(px, 0));
    float3 v = normalize(frame.cameraPos.xyz - reconstruct(px, depth));
    if (depth >= 1.0) {
        hdrOut[tid.xy] = float4(skyColor(-v), 1.0);
        return;
    }
    float3 p = reconstruct(px, depth);
    float4 a = gAlbedo.Load(int3(px, 0));
    float4 nr = gNormal.Load(int3(px, 0));
    float3 n = normalize(nr.xyz);
    float m = floor(nr.w / 2.0) * 2.0;
    float rough = nr.w - m;
    float matId = m / 2.0;
    float3 albedo = a.rgb;
    float metal = a.a;
    uint seed = gtHash(pixelSeed(tid.xy) ^ 0x2545F491u);
    float u1 = gtHashFloat(seed), u2 = gtHashFloat(seed ^ 0x68E31DA4u);
    float2 vis = filteredVisibility(px, p, n);
    float shadow = vis.x, ao = vis.y;
    float3 l = frame.sunDir.xyz;
    float3 origin = p + n * 0.02;
    float ndl = saturate(dot(n, l));

    // GGX-ish direct light.
    float3 h = normalize(v + l);
    float nh = saturate(dot(n, h)), nv = max(dot(n, v), 1e-3), vh = saturate(dot(v, h));
    float alpha = max(rough * rough, 0.01);
    float d = alpha * alpha / (3.14159 * pow(nh * nh * (alpha * alpha - 1.0) + 1.0, 2.0));
    float3 f0 = lerp(float3(0.04, 0.04, 0.04), albedo, metal);
    float3 fres = f0 + (1.0 - f0) * pow(1.0 - vh, 5.0);
    float3 spec = d * fres / (4.0 * nv + 0.1) * ndl;
    float3 diffuse = (1.0 - metal) * albedo / 3.14159 * ndl;
    float3 color = (diffuse + spec) * frame.sunColor.rgb * frame.sunDir.w * shadow;
    float3 ambient = lerp(float3(0.10, 0.10, 0.09), float3(0.28, 0.33, 0.42), n.y * 0.5 + 0.5);
    color += (1.0 - metal) * albedo * ambient * ao;

    // Reflections for smooth surfaces: one ray, roughness-jittered.
    float3 fv = f0 + (1.0 - f0) * pow(1.0 - nv, 5.0);
    if (rough < 0.45 || metal > 0.5) {
        float3 rdir = normalize(reflect(-v, n) + (float3(u1, u2, gtHashFloat(seed * 3u)) - 0.5) * rough * 0.6);
        RayDesc r;
        r.Origin = origin;
        r.Direction = rdir;
        r.TMin = 0.0;
        r.TMax = 300.0;
        RayQuery<RAY_FLAG_FORCE_OPAQUE> q;
        q.TraceRayInline(scene, RAY_FLAG_NONE, 0xFF, r);
        q.Proceed();
        float3 refl = q.CommittedStatus() == COMMITTED_TRIANGLE_HIT ? shadeHit(q, rdir) : skyColor(rdir);
        color += refl * fv * (1.0 - rough);
    } else {
        color += skyColor(reflect(-v, n)) * fv * 0.15 * ao;
    }
    if (matId == kWater) color = lerp(color, color * float3(0.6, 0.8, 0.85), 0.3);
    hdrOut[tid.xy] = float4(color, 1.0);
}

// --- composite --------------------------------------------------------------------------------------
Texture2D<float4> hdrTex : register(t8);

struct FsOut {
    float4 pos : SV_Position;
};

[shader("vertex")]
FsOut vsFullscreen(uint vid: SV_VertexID) {
    float2 uv = float2(float((vid << 1u) & 2u), float(vid & 2u));
    FsOut o;
    o.pos = float4(uv * float2(2.0, -2.0) + float2(-1.0, 1.0), 0.0, 1.0);
    return o;
}

[shader("fragment")]
float4 psComposite(FsOut i) : SV_Target {
    float3 x = hdrTex.Load(int3(int2(i.pos.xy), 0)).rgb * 0.75;
    x = saturate((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14));
    return float4(pow(x, 1.0 / 2.2), 1.0);
}
