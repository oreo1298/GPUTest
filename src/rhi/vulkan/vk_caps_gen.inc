std::string capFlagsString(unsigned long long v, const CapFlagBit* bits, std::size_t count) {
    if (v == 0) return "none";
    std::string s;
    unsigned long long rest = v;
    for (std::size_t i = 0; i < count; ++i) {
        if ((v & bits[i].bit) == 0) continue;
        if (!s.empty()) s += " | ";
        s += bits[i].name;
        rest &= ~bits[i].bit;
    }
    if (rest != 0) {
        if (!s.empty()) s += " | ";
        s += std::format("0x{:x}", rest);
    }
    return s;
}

