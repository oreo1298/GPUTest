void collectFeatures(VkPhysicalDevice pd, std::uint32_t apiVersion,
                     const std::function<bool(const char*)>& hasExtension, std::vector<Capability>& out) {
    VkPhysicalDeviceFeatures2 top{};
    top.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2;
    CapFeatureStorage storage{};
    std::vector<std::string> groups; // per chain entry: row group, or empty when not chained
    PFN_vkGetPhysicalDeviceFeatures2 query = vkGetPhysicalDeviceFeatures2 != nullptr ? vkGetPhysicalDeviceFeatures2 : vkGetPhysicalDeviceFeatures2KHR;
    if (query != nullptr) {
        groups = capBuildChain(&top, &storage, kCapFeatureChain, std::size(kCapFeatureChain), kCapFeatureProviders, apiVersion,
                               hasExtension, "Features: ");
        query(pd, &top);
    } else if (vkGetPhysicalDeviceFeatures != nullptr) {
        vkGetPhysicalDeviceFeatures(pd, &top.features);
    }
    capAddRows(out, "Features: Vulkan 1.0", &top.features, kFeat_Core, std::size(kFeat_Core));
    capAddChained(out, groups, &storage, kCapFeatureChain);
}

void collectProperties(VkPhysicalDevice pd, std::uint32_t apiVersion,
                       const std::function<bool(const char*)>& hasExtension, std::vector<Capability>& out) {
    VkPhysicalDeviceProperties2 top{};
    top.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2;
    CapPropertyStorage storage{};
    std::vector<std::string> groups; // per chain entry: row group, or empty when not chained
    PFN_vkGetPhysicalDeviceProperties2 query = vkGetPhysicalDeviceProperties2 != nullptr ? vkGetPhysicalDeviceProperties2 : vkGetPhysicalDeviceProperties2KHR;
    if (query != nullptr) {
        groups = capBuildChain(&top, &storage, kCapPropertyChain, std::size(kCapPropertyChain), kCapPropertyProviders, apiVersion,
                               hasExtension, "Properties: ");
        query(pd, &top);
    } else if (vkGetPhysicalDeviceProperties != nullptr) {
        vkGetPhysicalDeviceProperties(pd, &top.properties);
    }
    capAddRows(out, "Properties: Vulkan 1.0", &top.properties, kProp_Core, std::size(kProp_Core));
    capAddRows(out, "Limits", &top.properties.limits, kProp_Limits, std::size(kProp_Limits));
    capAddRows(out, "Sparse properties", &top.properties.sparseProperties, kProp_Sparse, std::size(kProp_Sparse));
    capAddChained(out, groups, &storage, kCapPropertyChain);
}

